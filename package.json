{
  "name": "llm-dictionary",
  "version": "1.0.0",
  "description": "AI dictionary and semantic word connections with durable caching",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "npm run check && npm run build:worker && opennextjs-cloudflare deploy && npm run test:smoke",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:smoke": "tsx scripts/smoke.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.9",
    "d3-force": "^3.0.0",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  },
  "private": true,
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.5"
  }
}
